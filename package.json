{
  "name": "pfnodeapp",
  "version": "1.0.0",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "dev": "set NODE_ENV=development&& npm run tsBuild && npm run start",
    "devExperiment": "set NODE_ENV=development&& nodemon -e ts --exec \"rm -rf dist/* && tsc -p . && npm run start\"",
    "start": "node --enable-source-maps --watch dist/app.js",
    "debug": "node --inspect-brk --trace-warnings --enable-source-maps dist/app.js",
    "prod": "set NODE_ENV=production&& npm run start",
    "tsWatch": "tsc --watch",
    "tsBuild": "rm -rf dist/* && tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "node build.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "schema-check": "typeorm schema:log -d dist/data-source.js",
    "schema-build-check": "npm run build && npm run typeorm-schema-check"
  },
  "keywords": [],
  "author": "Dhawal Joshi",
  "license": "SEE LICENSE in license.md",
  "description": "Node Companion App",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/sqlite3": "^3.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-typeorm-typescript": "^0.5.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lodash-es": "^4.18.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31",
    "zod": "^4.6.5"
  }
}
