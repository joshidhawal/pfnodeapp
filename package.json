{
  "name": "pfnodeapp",
  "version": "1.0.0",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon -e ts --exec \"tsc -p . && node dist/app.js\"",
    "start": "node dist/app.js",
    "tstranspile": "tsc --watch",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "schema-check": "typeorm schema:log -d dist/data-source.js",
    "schema-build-check": "npm run build && npm run typeorm-schema-check"
  },
  "keywords": [],
  "author": "Dhawal Joshi",
  "license": "SEE LICENSE in license.md",
  "description": "Node Companion App",
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/sqlite3": "^3.1.11",
    "nodemon": "^3.1.7",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "express": "^5.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.26"
  }
}
